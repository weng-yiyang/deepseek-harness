# Electron 二进制下载镜像（解决国内网络 ECONNRESET）
# 注意：这不是 npm 的官方配置项，而是 electron 安装脚本从 .npmrc 读取的键，
# 不能用 `npm config set electron_mirror` 设置（npm 会拒），必须写进 .npmrc 文件。
electron_mirror=https://npmmirror.com/mirrors/electron/

# electron-builder 工具链（NSIS 等）镜像，打包时才用得到
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
